# Data is never committed (licences + size). See docs/data.md.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/MANIFEST.example.json

# Generated results are reproduced by `make eval`; only the README is tracked.
results/*
!results/README.md

# LLM outputs can be large; they live on UBELIX / data/interim.
*.jsonl.gz

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# LaTeX
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
paper/*.pdf

# OS / editors
.DS_Store
.idea/
.vscode/
.env
